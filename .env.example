# Public URLs used by the Vite browser build (not secret credentials).
VITE_NEON_AUTH_URL=
VITE_NEON_FUNCTION_HELLO_BASE_URL=

# Local database tooling only. Keep the real value private in .env.local.
DATABASE_URL_UNPOOLED=

# Used by the deployed Neon Function, not by the browser app.
# Set these in the Function's server-side environment instead.
# DATABASE_URL=
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# APP_ALLOWED_ORIGINS=
